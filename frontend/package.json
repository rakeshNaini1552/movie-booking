{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^26"
  },
  "config": {
    "port": "3001"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-$npm_package_config_port}",
    "build": "next build",
    "start": "next start -p ${PORT:-$npm_package_config_port}",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.3.0",
    "geist": "^1.9.2",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
