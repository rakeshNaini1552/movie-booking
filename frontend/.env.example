# Server-only settings. Copy to .env.local to override. Never commit .env.local.
# Defaults shown here match src/lib/env-schema.ts.
# PORT is read from the shell by `npm run dev`/`npm start`; a PORT in .env.local does not move the dev server.
GATEWAY_URL=http://localhost:8090
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/movie-booking
PORT=3001

# Auth.js login. Public origin of this app (callback and post-logout URLs):
AUTH_URL=http://localhost:3001
AUTH_KEYCLOAK_ID=movie-booking-web

# Secrets: NO defaults, the app refuses to start without them. Fill in locally.
# AUTH_SECRET: at least 32 characters, e.g. `openssl rand -base64 32`.
# AUTH_KEYCLOAK_SECRET: the client secret of the confidential client in Keycloak.
AUTH_SECRET=
AUTH_KEYCLOAK_SECRET=
